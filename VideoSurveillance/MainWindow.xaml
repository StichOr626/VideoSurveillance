<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="VideoSurveillance.MainWindow"
        Title="Система видеонаблюдения" Background="#FF85B8FF" WindowState = "Maximized" WindowStyle="None" av:DesignHeight="345.838" av:DesignWidth="714.4">
    <Grid>
        <ComboBox x:Name="CameraList" HorizontalAlignment="Left" Margin="10,10,0,0" Width="300" VerticalAlignment="Top" BorderBrush="Black" Background="Gainsboro" Height="30">
            <ComboBox.Effect>
                <DropShadowEffect/>
            </ComboBox.Effect>
        </ComboBox>
        <Button Content="Добавить Камеру" HorizontalAlignment="Left" Margin="350,10,0,0" Width="150" Click="Start_Click" Height="30" VerticalAlignment="Top" BorderBrush="#FF161616" Background="#FFD7D7D7">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
        </Button>
        <Button Content="Остановить Все" HorizontalAlignment="Left" Margin="510,10,0,0" Width="150" Click="Stop_Click" Height="30" VerticalAlignment="Top" Background="#FFD7D7D7" BorderBrush="Black">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
        </Button>
        <Button Content="X" Click="Button_exit" HorizontalAlignment="Right"  VerticalAlignment="Top" Width="26" Height="25" Background="#FFCB0000" FontSize="14" FontFamily="Arial"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,50,10,10" BorderBrush="Black" Background="#FF959595" OpacityMask="Black">
            <ScrollViewer.Effect>
                <DropShadowEffect/>
            </ScrollViewer.Effect>
            <WrapPanel x:Name="VideoPanel" />
        </ScrollViewer>

    </Grid>
</Window>
